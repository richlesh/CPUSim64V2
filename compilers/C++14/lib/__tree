// __tree - the red-black tree of std::map, std::set, std::multimap and std::multiset
// for the CPUSim64 C++ translator (an internal header).
// The tree has a header node: header.parent is the root, header.left the leftmost and
// header.right the rightmost node; end() is the header.
#ifndef CPPC_TREE
#define CPPC_TREE

#include <cstddef>
#include <cstdlib>
#include <new>
#include <utility>
#include <iterator>
#include <initializer_list>

namespace std {

struct __tree_node_base {
    __tree_node_base *parent, *left, *right;
    bool red;
};

inline __tree_node_base *__tree_min(__tree_node_base *x) { while (x->left) x = x->left; return x; }
inline __tree_node_base *__tree_max(__tree_node_base *x) { while (x->right) x = x->right; return x; }

inline __tree_node_base *__tree_next(__tree_node_base *x) {
    if (x->right) return __tree_min(x->right);
    __tree_node_base *y = x->parent;
    while (x == y->right) { x = y; y = y->parent; }
    if (x->right != y) x = y;
    return x;
}

inline __tree_node_base *__tree_prev(__tree_node_base *x) {
    if (x->red && x->parent->parent == x) return x->right;          // end(): the rightmost node
    if (x->left) return __tree_max(x->left);
    __tree_node_base *y = x->parent;
    while (x == y->left) { x = y; y = y->parent; }
    return y;
}

inline void __tree_rotate_left(__tree_node_base *x, __tree_node_base *&root) {
    __tree_node_base *y = x->right;
    x->right = y->left;
    if (y->left) y->left->parent = x;
    y->parent = x->parent;
    if (x == root) root = y;
    else if (x == x->parent->left) x->parent->left = y;
    else x->parent->right = y;
    y->left = x;
    x->parent = y;
}

inline void __tree_rotate_right(__tree_node_base *x, __tree_node_base *&root) {
    __tree_node_base *y = x->left;
    x->left = y->right;
    if (y->right) y->right->parent = x;
    y->parent = x->parent;
    if (x == root) root = y;
    else if (x == x->parent->right) x->parent->right = y;
    else x->parent->left = y;
    y->right = x;
    x->parent = y;
}

// links the new node x below p (on the left if left) and rebalances
inline void __tree_insert_fixup(bool left, __tree_node_base *x, __tree_node_base *p, __tree_node_base &h) {
    __tree_node_base *&root = h.parent;
    x->parent = p;
    x->left = x->right = 0;
    x->red = true;
    if (left) {
        p->left = x;
        if (p == &h) { h.parent = x; h.right = x; }
        else if (p == h.left) h.left = x;
    } else {
        p->right = x;
        if (p == h.right) h.right = x;
    }
    while (x != root && x->parent->red) {
        __tree_node_base *g = x->parent->parent;
        if (x->parent == g->left) {
            __tree_node_base *y = g->right;
            if (y && y->red) {
                x->parent->red = false;
                y->red = false;
                g->red = true;
                x = g;
            } else {
                if (x == x->parent->right) { x = x->parent; __tree_rotate_left(x, root); }
                x->parent->red = false;
                g->red = true;
                __tree_rotate_right(g, root);
            }
        } else {
            __tree_node_base *y = g->left;
            if (y && y->red) {
                x->parent->red = false;
                y->red = false;
                g->red = true;
                x = g;
            } else {
                if (x == x->parent->left) { x = x->parent; __tree_rotate_right(x, root); }
                x->parent->red = false;
                g->red = true;
                __tree_rotate_left(g, root);
            }
        }
    }
    root->red = false;
}

// unlinks z from the tree and rebalances; returns z
inline __tree_node_base *__tree_erase_fixup(__tree_node_base *z, __tree_node_base &h) {
    __tree_node_base *&root = h.parent;
    __tree_node_base *&leftmost = h.left;
    __tree_node_base *&rightmost = h.right;
    __tree_node_base *y = z, *x = 0, *xp = 0;
    if (!y->left) x = y->right;
    else if (!y->right) x = y->left;
    else {
        y = y->right;
        while (y->left) y = y->left;
        x = y->right;
    }
    if (y != z) {
        z->left->parent = y;
        y->left = z->left;
        if (y != z->right) {
            xp = y->parent;
            if (x) x->parent = y->parent;
            y->parent->left = x;
            y->right = z->right;
            z->right->parent = y;
        } else xp = y;
        if (root == z) root = y;
        else if (z->parent->left == z) z->parent->left = y;
        else z->parent->right = y;
        y->parent = z->parent;
        bool c = y->red; y->red = z->red; z->red = c;
        y = z;
    } else {
        xp = y->parent;
        if (x) x->parent = y->parent;
        if (root == z) root = x;
        else if (z->parent->left == z) z->parent->left = x;
        else z->parent->right = x;
        if (leftmost == z) leftmost = z->right ? __tree_min(x) : z->parent;
        if (rightmost == z) rightmost = z->left ? __tree_max(x) : z->parent;
    }
    if (!y->red) {
        while (x != root && (!x || !x->red)) {
            if (x == xp->left) {
                __tree_node_base *w = xp->right;
                if (w->red) { w->red = false; xp->red = true; __tree_rotate_left(xp, root); w = xp->right; }
                if ((!w->left || !w->left->red) && (!w->right || !w->right->red)) {
                    w->red = true;
                    x = xp;
                    xp = xp->parent;
                } else {
                    if (!w->right || !w->right->red) {
                        if (w->left) w->left->red = false;
                        w->red = true;
                        __tree_rotate_right(w, root);
                        w = xp->right;
                    }
                    w->red = xp->red;
                    xp->red = false;
                    if (w->right) w->right->red = false;
                    __tree_rotate_left(xp, root);
                    break;
                }
            } else {
                __tree_node_base *w = xp->left;
                if (w->red) { w->red = false; xp->red = true; __tree_rotate_right(xp, root); w = xp->left; }
                if ((!w->right || !w->right->red) && (!w->left || !w->left->red)) {
                    w->red = true;
                    x = xp;
                    xp = xp->parent;
                } else {
                    if (!w->left || !w->left->red) {
                        if (w->right) w->right->red = false;
                        w->red = true;
                        __tree_rotate_left(w, root);
                        w = xp->left;
                    }
                    w->red = xp->red;
                    xp->red = false;
                    if (w->left) w->left->red = false;
                    __tree_rotate_right(xp, root);
                    break;
                }
            }
        }
        if (x) x->red = false;
    }
    return y;
}

template<class V> struct __tree_node : __tree_node_base {
    V value;
};

template<class V, class Ref, class Ptr> struct __tree_iterator {
    typedef V value_type;
    typedef Ref reference;
    typedef Ptr pointer;
    typedef ptrdiff_t difference_type;
    typedef bidirectional_iterator_tag iterator_category;
    __tree_node_base *n;
    __tree_iterator() : n(0) {}
    explicit __tree_iterator(__tree_node_base *x) : n(x) {}
    __tree_iterator(const __tree_iterator<V, V &, V *> &o) : n(o.n) {}
    Ref operator*() const { return static_cast<__tree_node<V> *>(n)->value; }
    Ptr operator->() const { return &static_cast<__tree_node<V> *>(n)->value; }
    __tree_iterator &operator++() { n = __tree_next(n); return *this; }
    __tree_iterator operator++(int) { __tree_iterator t = *this; n = __tree_next(n); return t; }
    __tree_iterator &operator--() { n = __tree_prev(n); return *this; }
    __tree_iterator operator--(int) { __tree_iterator t = *this; n = __tree_prev(n); return t; }
    bool operator==(const __tree_iterator &o) const { return n == o.n; }
    bool operator!=(const __tree_iterator &o) const { return n != o.n; }
};

// KeyOf extracts the key from a value: the value itself for sets, .first for maps
template<class K, class V, class KeyOf, class C> class __tree {
public:
    typedef __tree_node<V> node;
    typedef __tree_iterator<V, V &, V *> iterator;
    typedef __tree_iterator<V, const V &, const V *> const_iterator;

    __tree_node_base h;
    size_t n;
    C comp;

    void init_header() { h.parent = 0; h.left = &h; h.right = &h; h.red = true; n = 0; }

    __tree() : comp() { init_header(); }
    explicit __tree(const C &c) : comp(c) { init_header(); }
    __tree(const __tree &o) : comp(o.comp) { init_header(); copy_from(o); }
    __tree(__tree &&o) : comp(o.comp) { init_header(); take(o); }
    ~__tree() { clear(); }

    __tree &operator=(const __tree &o) { if (this != &o) { clear(); comp = o.comp; copy_from(o); } return *this; }
    __tree &operator=(__tree &&o) { if (this != &o) { clear(); take(o); } return *this; }

    void take(__tree &o) {
        if (o.h.parent) {
            h.parent = o.h.parent;
            h.left = o.h.left;
            h.right = o.h.right;
            h.parent->parent = &h;
            n = o.n;
            o.init_header();
        }
    }
    void copy_from(const __tree &o) {
        for (const_iterator i = o.begin(); i != o.end(); ++i) insert_multi(*i);
    }

    static const K &key(const __tree_node_base *x) { return KeyOf()(static_cast<const node *>(x)->value); }

    iterator begin() { return iterator(h.left); }
    const_iterator begin() const { return const_iterator(const_cast<__tree_node_base *>(h.left)); }
    iterator end() { return iterator(&h); }
    const_iterator end() const { return const_iterator(const_cast<__tree_node_base *>(&h)); }
    size_t size() const { return n; }
    bool empty() const { return n == 0; }

    void destroy(__tree_node_base *x) {
        while (x) {
            destroy(x->right);
            __tree_node_base *l = x->left;
            node *nd = static_cast<node *>(x);
            nd->value.~V();
            free(nd);
            x = l;
        }
    }
    void clear() { destroy(h.parent); init_header(); }

    template<class... A> node *make_node(A &&... a) {
        node *nd = (node *)malloc(sizeof(node));
        new (&nd->value) V(std::forward<A>(a)...);
        return nd;
    }

    __tree_node_base *lower(const K &k) const {
        __tree_node_base *y = const_cast<__tree_node_base *>(&h), *x = h.parent;
        while (x) {
            if (!comp(key(x), k)) { y = x; x = x->left; }
            else x = x->right;
        }
        return y;
    }
    __tree_node_base *upper(const K &k) const {
        __tree_node_base *y = const_cast<__tree_node_base *>(&h), *x = h.parent;
        while (x) {
            if (comp(k, key(x))) { y = x; x = x->left; }
            else x = x->right;
        }
        return y;
    }
    iterator lower_bound(const K &k) { return iterator(lower(k)); }
    const_iterator lower_bound(const K &k) const { return const_iterator(lower(k)); }
    iterator upper_bound(const K &k) { return iterator(upper(k)); }
    const_iterator upper_bound(const K &k) const { return const_iterator(upper(k)); }
    iterator find(const K &k) {
        __tree_node_base *y = lower(k);
        if (y == &h || comp(k, key(y))) return end();
        return iterator(y);
    }
    const_iterator find(const K &k) const {
        __tree_node_base *y = lower(k);
        if (y == &h || comp(k, key(y))) return end();
        return const_iterator(y);
    }
    size_t count(const K &k) const {
        size_t c = 0;
        for (__tree_node_base *x = lower(k), *e = upper(k); x != e; x = __tree_next(x)) ++c;
        return c;
    }

    // the place where a node with the key k goes; *found is the node with an equal key (unique insertion)
    __tree_node_base *place(const K &k, bool &left, __tree_node_base *&found) const {
        __tree_node_base *y = const_cast<__tree_node_base *>(&h), *x = h.parent;
        bool lt = true;
        found = 0;
        while (x) {
            y = x;
            lt = comp(k, key(x));
            x = lt ? x->left : x->right;
        }
        left = y == &h || lt;
        __tree_node_base *j = y;
        if (lt) {
            if (j == h.left) return y;
            j = __tree_prev(j);
        }
        if (j != &h && !comp(key(j), k)) found = j;
        return y;
    }

    pair<iterator, bool> insert_node_unique(node *nd) {
        bool left;
        __tree_node_base *found;
        __tree_node_base *p = place(KeyOf()(nd->value), left, found);
        if (found) {
            nd->value.~V();
            free(nd);
            return pair<iterator, bool>(iterator(found), false);
        }
        __tree_insert_fixup(left, nd, p, h);
        ++n;
        return pair<iterator, bool>(iterator(nd), true);
    }
    template<class... A> pair<iterator, bool> emplace_unique(A &&... a) { return insert_node_unique(make_node(std::forward<A>(a)...)); }
    pair<iterator, bool> insert_unique(const V &v) {
        bool left;
        __tree_node_base *found;
        __tree_node_base *p = place(KeyOf()(v), left, found);
        if (found) return pair<iterator, bool>(iterator(found), false);
        node *nd = make_node(v);
        __tree_insert_fixup(left, nd, p, h);
        ++n;
        return pair<iterator, bool>(iterator(nd), true);
    }
    iterator insert_multi(const V &v) {
        node *nd = make_node(v);
        __tree_node_base *y = &h, *x = h.parent;
        bool lt = true;
        while (x) {
            y = x;
            lt = comp(KeyOf()(v), key(x));
            x = lt ? x->left : x->right;
        }
        __tree_insert_fixup(y == &h || lt, nd, y, h);
        ++n;
        return iterator(nd);
    }
    iterator erase(const_iterator pos) {
        __tree_node_base *x = pos.n;
        __tree_node_base *nx = __tree_next(x);
        __tree_erase_fixup(x, h);
        node *nd = static_cast<node *>(x);
        nd->value.~V();
        free(nd);
        --n;
        return iterator(nx);
    }
    iterator erase(const_iterator first, const_iterator last) {
        while (first != last) first = erase(first);
        return iterator(last.n);
    }
    size_t erase_key(const K &k) {
        size_t c = 0;
        __tree_node_base *x = lower(k), *e = upper(k);
        while (x != e) {
            __tree_node_base *nx = __tree_next(x);
            erase(const_iterator(x));
            x = nx;
            ++c;
        }
        return c;
    }
    void swap(__tree &o) {
        __tree tmp(std::move(o));
        o.take(*this);
        take(tmp);
    }
};

}

#endif
