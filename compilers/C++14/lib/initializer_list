// <initializer_list> - std::initializer_list for the CPUSim64 C++ translator.
// The translator builds the backing array of a braced list and calls the
// constructor (const E *, unsigned long).
#ifndef CPPC_INITIALIZER_LIST
#define CPPC_INITIALIZER_LIST

namespace std {

template<class E> class initializer_list {
    const E *first_;
    unsigned long n_;
public:
    typedef E value_type;
    typedef const E &reference;
    typedef const E &const_reference;
    typedef unsigned long size_type;
    typedef const E *iterator;
    typedef const E *const_iterator;
    initializer_list() : first_(0), n_(0) {}
    initializer_list(const E *p, unsigned long n) : first_(p), n_(n) {}
    const E *begin() const { return first_; }
    const E *end() const { return first_ + n_; }
    unsigned long size() const { return n_; }
};

template<class E> const E *begin(initializer_list<E> l) { return l.begin(); }
template<class E> const E *end(initializer_list<E> l) { return l.end(); }

}

#endif
