// <memory> - unique_ptr, shared_ptr, weak_ptr and make_* for the CPUSim64 C++ translator.
#ifndef CPPC_MEMORY
#define CPPC_MEMORY

#include <cstddef>
#include <cstdlib>
#include <new>
#include <utility>
#include <type_traits>

namespace std {

template<class T> struct default_delete {
    default_delete() {}
    template<class U> default_delete(const default_delete<U> &) {}
    void operator()(T *p) const { delete p; }
};
template<class T> struct default_delete<T[]> {
    default_delete() {}
    void operator()(T *p) const { delete[] p; }
};

template<class T, class D = default_delete<T>> class unique_ptr {
    T *p_;
    D d_;
public:
    typedef T element_type;
    typedef T *pointer;
    typedef D deleter_type;

    unique_ptr() : p_(0), d_() {}
    unique_ptr(nullptr_t) : p_(0), d_() {}
    explicit unique_ptr(T *p) : p_(p), d_() {}
    unique_ptr(T *p, const D &d) : p_(p), d_(d) {}
    unique_ptr(unique_ptr &&o) : p_(o.p_), d_(std::move(o.d_)) { o.p_ = 0; }
    template<class U, class E> unique_ptr(unique_ptr<U, E> &&o) : p_(o.release()), d_(std::move(o.get_deleter())) {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (p_) d_(p_); }

    unique_ptr &operator=(unique_ptr &&o) {
        reset(o.release());
        d_ = std::move(o.d_);
        return *this;
    }
    template<class U, class E> unique_ptr &operator=(unique_ptr<U, E> &&o) { reset(o.release()); return *this; }
    unique_ptr &operator=(nullptr_t) { reset(); return *this; }

    T *get() const { return p_; }
    D &get_deleter() { return d_; }
    const D &get_deleter() const { return d_; }
    T *release() { T *p = p_; p_ = 0; return p; }
    void reset(T *p = 0) { T *old = p_; p_ = p; if (old) d_(old); }
    void swap(unique_ptr &o) { T *t = p_; p_ = o.p_; o.p_ = t; std::swap(d_, o.d_); }
    explicit operator bool() const { return p_ != 0; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
};

template<class T, class D> class unique_ptr<T[], D> {
    T *p_;
    D d_;
public:
    typedef T element_type;
    unique_ptr() : p_(0), d_() {}
    explicit unique_ptr(T *p) : p_(p), d_() {}
    unique_ptr(unique_ptr &&o) : p_(o.p_), d_() { o.p_ = 0; }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (p_) d_(p_); }
    unique_ptr &operator=(unique_ptr &&o) { reset(o.release()); return *this; }
    T *get() const { return p_; }
    T *release() { T *p = p_; p_ = 0; return p; }
    void reset(T *p = 0) { T *old = p_; p_ = p; if (old) d_(old); }
    explicit operator bool() const { return p_ != 0; }
    T &operator[](size_t i) const { return p_[i]; }
};

template<class T> struct __uptr_if { typedef unique_ptr<T> single; };
template<class T> struct __uptr_if<T[]> { typedef unique_ptr<T[]> array; };

template<class T, class... A> inline typename __uptr_if<T>::single make_unique(A &&... a) {
    return unique_ptr<T>(new T(std::forward<A>(a)...));
}
template<class T> inline typename __uptr_if<T>::array make_unique(size_t n) {
    return unique_ptr<T>(new typename remove_extent<T>::type[n]());
}

template<class T, class D, class U, class E> inline bool operator==(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b) { return a.get() == b.get(); }
template<class T, class D, class U, class E> inline bool operator!=(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b) { return a.get() != b.get(); }
template<class T, class D, class U, class E> inline bool operator<(const unique_ptr<T, D> &a, const unique_ptr<U, E> &b) { return a.get() < b.get(); }
template<class T, class D> inline bool operator==(const unique_ptr<T, D> &a, nullptr_t) { return !a; }
template<class T, class D> inline bool operator==(nullptr_t, const unique_ptr<T, D> &a) { return !a; }
template<class T, class D> inline bool operator!=(const unique_ptr<T, D> &a, nullptr_t) { return (bool)a; }
template<class T, class D> inline bool operator!=(nullptr_t, const unique_ptr<T, D> &a) { return (bool)a; }
template<class T, class D> inline void swap(unique_ptr<T, D> &a, unique_ptr<T, D> &b) { a.swap(b); }

// ---- shared_ptr

struct __ctrl {
    long strong;
    long weak;
    __ctrl() : strong(1), weak(1) {}
    virtual ~__ctrl() {}
    virtual void dispose() = 0;
    void release_strong() {
        if (--strong == 0) {
            dispose();
            release_weak();
        }
    }
    void release_weak() { if (--weak == 0) delete this; }
};

template<class T, class D> struct __ctrl_ptr : __ctrl {
    T *p;
    D d;
    __ctrl_ptr(T *x, D dd) : p(x), d(dd) {}
    void dispose() { d(p); }
};

template<class T> class weak_ptr;

template<class T> class shared_ptr {
    T *p_;
    __ctrl *c_;
    template<class U> friend class shared_ptr;
    template<class U> friend class weak_ptr;
    shared_ptr(T *p, __ctrl *c) : p_(p), c_(c) {}
public:
    typedef T element_type;
    shared_ptr() : p_(0), c_(0) {}
    shared_ptr(nullptr_t) : p_(0), c_(0) {}
    template<class U> explicit shared_ptr(U *p) : p_(p), c_(new __ctrl_ptr<U, default_delete<U>>(p, default_delete<U>())) {}
    template<class U, class D> shared_ptr(U *p, D d) : p_(p), c_(new __ctrl_ptr<U, D>(p, d)) {}
    shared_ptr(const shared_ptr &o) : p_(o.p_), c_(o.c_) { if (c_) ++c_->strong; }
    template<class U> shared_ptr(const shared_ptr<U> &o) : p_(o.p_), c_(o.c_) { if (c_) ++c_->strong; }
    shared_ptr(shared_ptr &&o) : p_(o.p_), c_(o.c_) { o.p_ = 0; o.c_ = 0; }
    template<class U> shared_ptr(shared_ptr<U> &&o) : p_(o.p_), c_(o.c_) { o.p_ = 0; o.c_ = 0; }
    template<class U, class D> shared_ptr(unique_ptr<U, D> &&u) : p_(0), c_(0) {
        U *raw = u.release();
        if (raw) { p_ = raw; c_ = new __ctrl_ptr<U, D>(raw, u.get_deleter()); }
    }
    ~shared_ptr() { if (c_) c_->release_strong(); }

    shared_ptr &operator=(const shared_ptr &o) { shared_ptr(o).swap(*this); return *this; }
    template<class U> shared_ptr &operator=(const shared_ptr<U> &o) { shared_ptr(o).swap(*this); return *this; }
    shared_ptr &operator=(shared_ptr &&o) { shared_ptr(std::move(o)).swap(*this); return *this; }
    template<class U> shared_ptr &operator=(shared_ptr<U> &&o) { shared_ptr(std::move(o)).swap(*this); return *this; }

    void swap(shared_ptr &o) {
        T *tp = p_; p_ = o.p_; o.p_ = tp;
        __ctrl *tc = c_; c_ = o.c_; o.c_ = tc;
    }
    void reset() { shared_ptr().swap(*this); }
    template<class U> void reset(U *p) { shared_ptr(p).swap(*this); }
    T *get() const { return p_; }
    T &operator*() const { return *p_; }
    T *operator->() const { return p_; }
    long use_count() const { return c_ ? c_->strong : 0; }
    bool unique() const { return use_count() == 1; }
    explicit operator bool() const { return p_ != 0; }

    template<class U> shared_ptr<U> __cast_to(U *q) const {
        if (c_) ++c_->strong;
        return shared_ptr<U>(q, c_);
    }
};

template<class T> class weak_ptr {
    T *p_;
    __ctrl *c_;
public:
    weak_ptr() : p_(0), c_(0) {}
    weak_ptr(const weak_ptr &o) : p_(o.p_), c_(o.c_) { if (c_) ++c_->weak; }
    template<class U> weak_ptr(const shared_ptr<U> &s) : p_(s.p_), c_(s.c_) { if (c_) ++c_->weak; }
    ~weak_ptr() { if (c_) c_->release_weak(); }
    weak_ptr &operator=(const weak_ptr &o) { weak_ptr t(o); swap(t); return *this; }
    template<class U> weak_ptr &operator=(const shared_ptr<U> &s) { weak_ptr t(s); swap(t); return *this; }
    void swap(weak_ptr &o) { T *tp = p_; p_ = o.p_; o.p_ = tp; __ctrl *tc = c_; c_ = o.c_; o.c_ = tc; }
    void reset() { weak_ptr t; swap(t); }
    long use_count() const { return c_ ? c_->strong : 0; }
    bool expired() const { return use_count() == 0; }
    shared_ptr<T> lock() const {
        if (c_ && c_->strong > 0) { ++c_->strong; return shared_ptr<T>(p_, c_); }
        return shared_ptr<T>();
    }
};

template<class T, class... A> inline shared_ptr<T> make_shared(A &&... a) { return shared_ptr<T>(new T(std::forward<A>(a)...)); }

template<class T, class U> inline bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) { return a.get() == b.get(); }
template<class T, class U> inline bool operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) { return a.get() != b.get(); }
template<class T, class U> inline bool operator<(const shared_ptr<T> &a, const shared_ptr<U> &b) { return a.get() < b.get(); }
template<class T> inline bool operator==(const shared_ptr<T> &a, nullptr_t) { return !a; }
template<class T> inline bool operator==(nullptr_t, const shared_ptr<T> &a) { return !a; }
template<class T> inline bool operator!=(const shared_ptr<T> &a, nullptr_t) { return (bool)a; }
template<class T> inline bool operator!=(nullptr_t, const shared_ptr<T> &a) { return (bool)a; }
template<class T> inline void swap(shared_ptr<T> &a, shared_ptr<T> &b) { a.swap(b); }

template<class T, class U> inline shared_ptr<T> static_pointer_cast(const shared_ptr<U> &s) { return s.__cast_to(static_cast<T *>(s.get())); }
template<class T, class U> inline shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U> &s) {
    T *q = dynamic_cast<T *>(s.get());
    if (!q) return shared_ptr<T>();
    return s.__cast_to(q);
}

template<class T> inline T *addressof(T &x) { return (T *)&reinterpret_cast<const volatile char &>(x); }

template<class T> struct allocator {
    typedef T value_type;
    T *allocate(size_t n) { return (T *)malloc(n * sizeof(T)); }
    void deallocate(T *p, size_t) { free(p); }
};

}

#endif
