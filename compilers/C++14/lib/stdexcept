// <stdexcept> - the standard exception classes for the CPUSim64 C++ translator.
#ifndef CPPC_STDEXCEPT
#define CPPC_STDEXCEPT

#include <exception>
#include <string>

namespace std {

class logic_error : public exception {
    string msg_;
public:
    explicit logic_error(const string &m) : msg_(m) {}
    explicit logic_error(const char *m) : msg_(m) {}
    virtual const char *what() const noexcept { return msg_.c_str(); }
};

class runtime_error : public exception {
    string msg_;
public:
    explicit runtime_error(const string &m) : msg_(m) {}
    explicit runtime_error(const char *m) : msg_(m) {}
    virtual const char *what() const noexcept { return msg_.c_str(); }
};

class domain_error : public logic_error {
public:
    explicit domain_error(const string &m) : logic_error(m) {}
    explicit domain_error(const char *m) : logic_error(m) {}
};
class invalid_argument : public logic_error {
public:
    explicit invalid_argument(const string &m) : logic_error(m) {}
    explicit invalid_argument(const char *m) : logic_error(m) {}
};
class length_error : public logic_error {
public:
    explicit length_error(const string &m) : logic_error(m) {}
    explicit length_error(const char *m) : logic_error(m) {}
};
class out_of_range : public logic_error {
public:
    explicit out_of_range(const string &m) : logic_error(m) {}
    explicit out_of_range(const char *m) : logic_error(m) {}
};
class range_error : public runtime_error {
public:
    explicit range_error(const string &m) : runtime_error(m) {}
    explicit range_error(const char *m) : runtime_error(m) {}
};
class overflow_error : public runtime_error {
public:
    explicit overflow_error(const string &m) : runtime_error(m) {}
    explicit overflow_error(const char *m) : runtime_error(m) {}
};
class underflow_error : public runtime_error {
public:
    explicit underflow_error(const string &m) : runtime_error(m) {}
    explicit underflow_error(const char *m) : runtime_error(m) {}
};

}

#endif
