      a=(MACRO_TT {delim_paren} toks:8 $ ( $ i : ident ) *)
      b=(MACRO_TT {delim_brace} toks:13 [ $ ( stringify ! ( $ i ) ) , * ])))
  (ITEM_MACRO_RULES early {delim_brace}
    (MACRO_RULE
      a=(MACRO_TT {delim_paren} toks:4 $ x : expr)
      b=(MACRO_TT {delim_brace} toks:10 if $ x > 0 { return 1 ; })))
