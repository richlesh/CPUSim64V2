  (ITEM_MACRO_RULES tuple_sum {delim_brace}
    (MACRO_RULE
      a=(MACRO_TT {delim_paren} toks:14 $ ( $ i : tt : $ t : ident ) , *)
      b=(MACRO_TT {delim_brace} toks:23 | t : ( $ ( $ t , ) * ) | 0 $ ( + t . $ i ) *)))
  (ITEM_MACRO_RULES strs {delim_brace}
