      b=(MACRO_TT {delim_brace} toks:64 $ ( # [ $ meta ] ) * $ vis enum $ name { $ ( $ variant = $ val ) , + } impl $ name { fn name ( & self ) -> & 'static str { match self { $ ( $ name :: $ variant => stringify ! ( $ variant ) ) , + } } })))
