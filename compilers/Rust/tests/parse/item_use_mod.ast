  (ITEM_USE
    a=(USE_TREE {glob}))
  (ITEM_USE
    a=(USE_TREE {group}
      a=(PATH
        (PATH_SEG a))
      (USE_TREE
        a=(PATH
          (PATH_SEG b)))
      (USE_TREE
        a=(PATH
          (PATH_SEG c)))))
  (ITEM_USE
    a=(USE_TREE {group}
      a=(PATH
        (PATH_SEG a))
      (USE_TREE
        a=(PATH
          (PATH_SEG b)))
      (USE_TREE
        a=(PATH
          (PATH_SEG c)))))
  (ITEM_USE
    a=(USE_TREE {group}
      a=(PATH
        (PATH_SEG a))
      (USE_TREE
        a=(PATH
          (PATH_SEG self)))
      (USE_TREE
        a=(PATH
          (PATH_SEG b)
          (PATH_SEG c)))
      (USE_TREE {group}
        a=(PATH
          (PATH_SEG d))
        (USE_TREE
          a=(PATH
            (PATH_SEG e)))
        (USE_TREE as:g
          a=(PATH
            (PATH_SEG f))))
      (USE_TREE {glob}
        a=(PATH
          (PATH_SEG h)))))
  (ITEM_USE
    a=(USE_TREE {group}
      (USE_TREE
        a=(PATH
          (PATH_SEG a)))
      (USE_TREE
        a=(PATH
          (PATH_SEG b)))))
  (ITEM_USE
