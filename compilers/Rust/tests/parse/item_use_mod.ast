        a=(PATH
          (PATH_SEG super)))))
  (ITEM_MOD with_attrs {inline}
    @(ATTR allow {inner,delim_paren} toks:1 dead_code)
    @(ATTR doc " inner doc" {inner,doc,eq})
    (ITEM_STRUCT S))
  (ITEM_MOD u {unsafe,inline}))
