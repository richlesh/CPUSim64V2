      (USE_TREE
        a=(PATH
          (PATH_SEG a)))
      (USE_TREE
        a=(PATH
          (PATH_SEG b)))))
  (ITEM_USE
    a=(USE_TREE
      a=(PATH
        (PATH_SEG self)
        (PATH_SEG a))))
  (ITEM_USE
    a=(USE_TREE
      a=(PATH
        (PATH_SEG super)
        (PATH_SEG a))))
  (ITEM_USE
    a=(USE_TREE
      a=(PATH
        (PATH_SEG super)
        (PATH_SEG super)
        (PATH_SEG a)
        (PATH_SEG b))))
  (ITEM_USE
    a=(USE_TREE
