      a=(PATH {global}
        (PATH_SEG a)
        (PATH_SEG b))))
  (ITEM_USE
    a=(USE_TREE {glob}
      a=(PATH
        (PATH_SEG a))))
  (ITEM_USE
    a=(USE_TREE {glob}
      a=(PATH
        (PATH_SEG a)
        (PATH_SEG b))))
  (ITEM_USE
    a=(USE_TREE {glob}
