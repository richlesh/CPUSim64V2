(CRATE
  (ITEM_USE
    a=(USE_TREE
      a=(PATH
        (PATH_SEG a))))
  (ITEM_USE
    a=(USE_TREE
      a=(PATH
        (PATH_SEG a)
        (PATH_SEG b))))
  (ITEM_USE
