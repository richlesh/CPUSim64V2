        (PATH_SEG b))))
  (ITEM_EXTERN_CRATE foo)
  (ITEM_EXTERN_CRATE foo as:bar)
  (ITEM_EXTERN_CRATE self as:me)
  (ITEM_EXTERN_CRATE foo as:_)
  (ITEM_EXTERN_CRATE baz
    vis=(VIS))
  (ITEM_MOD empty {inline})
  (ITEM_MOD outer {inline}
    (ITEM_MOD inner {inline}
      (ITEM_FN f
        c=(BLOCK)))
    (ITEM_FN g
      vis=(VIS)
      c=(BLOCK)))
  (ITEM_MOD declared)
  (ITEM_MOD public
    vis=(VIS))
  (ITEM_MOD in_crate {inline}
    vis=(VIS {vis_crate})
    (ITEM_USE
