(CRATE ->crate
  (ITEM_MOD a {inline} ->a
    (ITEM_MOD b {inline} ->a::b
      vis=(VIS)
      (ITEM_FN f ->a::b::f
        vis=(VIS)
        b=(T_PATH ->i32
          a=(PATH ->i32
            (PATH_SEG i32 ->i32)))
        c=(BLOCK
          a=(E_LIT_INT "1" #1)))
      (ITEM_STRUCT S {named} ->a::b::S
        vis=(VIS)
        (FIELD v ->a::b::S::v
          vis=(VIS)
          a=(T_PATH ->i32
            a=(PATH ->i32
              (PATH_SEG i32 ->i32)))))
      (ITEM_CONST K ->a::b::K
        vis=(VIS)
        a=(T_PATH ->i32
          a=(PATH ->i32
            (PATH_SEG i32 ->i32)))
        b=(E_LIT_INT "7" #7))
      (ITEM_TRAIT T ->a::b::T
        vis=(VIS)
        (ITEM_FN t ->a::b::T::t
          b=(T_PATH ->i32
            a=(PATH ->i32
              (PATH_SEG i32 ->i32)))
          (SELF_PARAM {ref} ->self)))
      (ITEM_IMPL ->S
        b=(T_PATH ->a::b::S
          a=(PATH ->a::b::S
            (PATH_SEG S ->a::b::S)))
        c=(PATH ->a::b::T
          (PATH_SEG T ->a::b::T))
        (ITEM_FN t ->S::t
          b=(T_PATH ->i32
            a=(PATH ->i32
              (PATH_SEG i32 ->i32)))
          c=(BLOCK
            a=(E_FIELD v
              a=(E_PATH ->self
                a=(PATH ->self
                  (PATH_SEG self ->self)))))
          (SELF_PARAM {ref} ->self))))
    (ITEM_USE
      vis=(VIS)
      a=(USE_TREE as:g
        a=(PATH
          (PATH_SEG self)
          (PATH_SEG b)
          (PATH_SEG f))))
    (ITEM_USE
      vis=(VIS)
      a=(USE_TREE {glob}
        a=(PATH
          (PATH_SEG self)
          (PATH_SEG b))))
    (ITEM_FN only_crate ->a::only_crate
      vis=(VIS {vis_crate})
      c=(BLOCK))
    (ITEM_FN only_super ->a::only_super
      vis=(VIS {vis_super})
      c=(BLOCK)))
  (ITEM_MOD chain {inline} ->chain
    (ITEM_USE
      vis=(VIS)
      a=(USE_TREE as:h
        a=(PATH
          (PATH_SEG crate)
          (PATH_SEG a)
          (PATH_SEG g))))
    (ITEM_USE
      vis=(VIS)
      a=(USE_TREE
        a=(PATH
          (PATH_SEG crate)
          (PATH_SEG chain2)
          (PATH_SEG h2)))))
  (ITEM_MOD chain2 {inline} ->chain2
    (ITEM_USE
      vis=(VIS)
      a=(USE_TREE as:h2
        a=(PATH
          (PATH_SEG crate)
          (PATH_SEG chain)
          (PATH_SEG h)))))
  (ITEM_USE
    a=(USE_TREE {group}
      a=(PATH
        (PATH_SEG a)
        (PATH_SEG b))
      (USE_TREE
        a=(PATH
          (PATH_SEG self)))
      (USE_TREE
        a=(PATH
          (PATH_SEG S)))
      (USE_TREE as:_
        a=(PATH
          (PATH_SEG T)))))
  (ITEM_USE
    a=(USE_TREE {group}
