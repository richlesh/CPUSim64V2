<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cloud.lesh</groupId>
        <artifactId>CPUSim64-parent</artifactId>
        <version>2.11.0</version>
    </parent>

    <artifactId>CPUSim64IDE</artifactId>
    <packaging>jar</packaging>

    <name>CPUSim64 IDE</name>
    <description>Integrated development environment for CPUSim64 assembly</description>

    <properties>
        <!-- Location of the Rust native simulator crate, relative to this module. -->
        <cpusim64.native.dir>${project.basedir}/../cpusim64_native</cpusim64.native.dir>
        <!-- Set -Dcpusim64.native.skip=true to skip building the Rust native
             simulator (e.g. on machines without a Rust/cargo toolchain). -->
        <cpusim64.native.skip>false</cpusim64.native.skip>
        <!-- Overridden to cpusim64_native.exe by the windows-native profile. -->
        <cpusim64.native.exe>cpusim64_native</cpusim64.native.exe>
    </properties>

    <dependencies>
        <!-- Sibling modules -->
        <dependency>
            <groupId>cloud.lesh</groupId>
            <artifactId>cpusim64</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.glowingcat</groupId>
            <artifactId>aichat</artifactId>
            <version>1.13.0</version>
        </dependency>
        <!-- Native Rust simulator module (pom packaging): declared so the reactor
             builds cpusim64_native before this module, guaranteeing the native
             executable exists for the copy-native-tool step. -->
        <dependency>
            <groupId>cloud.lesh</groupId>
            <artifactId>cpusim64_native</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- RSyntaxTextArea for code editor -->
        <dependency>
            <groupId>com.fifesoft</groupId>
            <artifactId>rsyntaxtextarea</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- JavaFX — explicit, classifier-pinned (see aichat/pom.xml rationale). -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
            <scope>${javafx.scope}</scope>
        </dependency>

        <!-- LaTeX math rendering -->
        <dependency>
            <groupId>org.scilab.forge</groupId>
            <artifactId>jlatexmath</artifactId>
            <version>1.0.7</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Normal application resources -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Copy LICENSE and NOTICE into META-INF -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Compile -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Copy the native executable (built by the cpusim64_native module)
                 + instructions.data into the classes output so the shade plugin
                 bundles them into the IDE JAR. Runs after compile (process-classes)
                 and before shade (package). Skippable via
                 -Dcpusim64.native.skip=true. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-native-tool</id>
                        <phase>process-classes</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <skip>${cpusim64.native.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${cpusim64.native.dir}/target/release</directory>
                                    <includes>
                                        <include>${cpusim64.native.exe}</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../cpusim64/src/main/resources</directory>
                                    <includes>
                                        <include>instructions.data</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Shade into single fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>LICENSE</exclude>
                                        <exclude>NOTICE</exclude>
                                        <!-- JLine ships prebuilt native Mach-O/ELF binaries that
                                             break macOS notarization (unsigned binaries inside the
                                             JAR). These arrive via the shaded cloud.lesh:CPUSim64
                                             artifact, so match them across ALL artifacts, not just
                                             org.jline:jline. -->
                                        <exclude>org/jline/nativ/Mac/**</exclude>
                                        <exclude>org/jline/nativ/Linux/**</exclude>
                                        <exclude>org/jline/nativ/FreeBSD/**</exclude>
                                        <exclude>org/jline/nativ/Windows/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.glowingcat.cpusim64ide.IDEApp</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                    <file>${project.basedir}/../LICENSE</file>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On Windows the cargo output is cpusim64_native.exe. -->
        <profile>
            <id>windows-native</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <cpusim64.native.exe>cpusim64_native.exe</cpusim64.native.exe>
            </properties>
        </profile>
    </profiles>
</project>
