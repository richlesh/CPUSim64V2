<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cloud.lesh</groupId>
    <artifactId>CPUSim64-parent</artifactId>
    <version>2.10.0</version>
    <packaging>pom</packaging>

    <name>CPUSim64 Parent</name>

    <properties>
        <app.version>2.10.0</app.version>
        <copyright.years>2025–2026</copyright.years>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <antlr.version>4.13.2</antlr.version>
        <junit.version>5.14.0</junit.version>
        <commonmark.version>0.24.0</commonmark.version>
        <javafx.version>21.0.13</javafx.version>
        <!-- Default scope for local/dev builds: JavaFX on the compile classpath
             and bundled at runtime. The 'release' profile overrides this to
             'provided' (JavaFX supplied by the jlink runtime image). Kept as a
             plain default (not tied to an activeByDefault profile) so the
             OS-activated javafx.platform profiles below do not suppress it. -->
        <javafx.scope>compile</javafx.scope>
    </properties>

    <profiles>
        <!-- Use for release/packaging builds: mvn -P release.
             JavaFX is supplied by the jlink runtime image, so it is 'provided'
             at compile time rather than bundled. -->
        <profile>
            <id>release</id>
            <properties>
                <javafx.scope>provided</javafx.scope>
            </properties>
        </profile>

        <!-- OpenJFX ships its real classes in platform-classified jars
             (javafx-*-<classifier>.jar); the default jar is an empty aggregator.
             These OS/arch-activated profiles set javafx.platform so the OpenJFX
             POMs resolve the correct native classifier automatically, without
             relying on a -Djavafx.platform flag being threaded through every
             Maven invocation. An explicit -Djavafx.platform on the CLI still
             overrides these. -->
        <profile>
            <id>javafx-linux-x64</id>
            <activation>
                <os><family>unix</family><name>linux</name><arch>amd64</arch></os>
            </activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-linux-aarch64</id>
            <activation>
                <os><family>unix</family><name>linux</name><arch>aarch64</arch></os>
            </activation>
            <properties><javafx.platform>linux-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-mac-x64</id>
            <activation>
                <os><family>mac</family><arch>x86_64</arch></os>
            </activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-mac-aarch64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-win-x64</id>
            <activation>
                <os><family>windows</family><arch>amd64</arch></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-win-aarch64</id>
            <activation>
                <os><family>windows</family><arch>aarch64</arch></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
    </profiles>

    <modules>
        <module>aichat</module>
        <module>cpusim64</module>
        <module>cpusim64_native</module>
        <module>ide</module>
    </modules>
</project>
