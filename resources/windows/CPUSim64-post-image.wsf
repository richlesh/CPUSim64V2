<?xml version="1.0" ?>
<job id="postimage">
<script language="JScript">
try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptDir = fso.GetParentFolderName(WScript.ScriptFullName);
    var mainWxs = scriptDir + "\\main.wxs";

    if (!fso.FileExists(mainWxs)) {
        WScript.Quit(0);
    }

    var file = fso.OpenTextFile(mainWxs, 1);
    var content = file.ReadAll();
    file.Close();

    var caDef = '    <CustomAction Id="UninstallCLI" Directory="INSTALLDIR" ExeCommand="cmd.exe /c CPUSim64.exe --uninstall" Execute="deferred" Impersonate="yes" Return="ignore" />\r\n';
    var seqEntry = '      <Custom Action="UninstallCLI" Before="RemoveFiles"><![CDATA[(REMOVE="ALL") AND (NOT UPGRADINGPRODUCTCODE)]]></Custom>\r\n';

    content = content.replace("</Product>", caDef + "  </Product>");

    if (content.indexOf("</InstallExecuteSequence>") >= 0) {
        content = content.replace("</InstallExecuteSequence>", seqEntry + "    </InstallExecuteSequence>");
    }

    var outFile = fso.CreateTextFile(mainWxs, true);
    outFile.Write(content);
    outFile.Close();
} catch(e) {
    // Never fail the build
}
WScript.Quit(0);
</script>
</job>
