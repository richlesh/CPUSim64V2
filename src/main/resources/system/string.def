///////////////////////////////////////////////////////////////////////////////
// STARTS_WITH(str, prefix) - Checks to see if the string begins with prefix
// str		Base address of string to search
// prefix	Prefix to cehck for
// Returns 	TRUE if prefix matches, otherwise FALSE
///////////////////////////////////////////////////////////////////////////////
#def_macro	STARTS_WITH(str, prefix)
	#macro	SUBSTRING_SEARCH(${str}, ${prefix}, 0)
	move	z, r0, TRUE, FALSE
#end_macro

///////////////////////////////////////////////////////////////////////////////
// ENDS_WITH(str, suffix) - Checks to see if the string ends with suffix
// str		Base address of string to search
// suffix	Suffix to cehck for
// Returns 	TRUE if suffix matches, otherwise FALSE
///////////////////////////////////////////////////////////////////////////////
#def_macro	ENDS_WITH(str, suffix)
	load	r1, ${str}[0]
	load	r2, ${suffix}[0]
	sub		r3, r1, r2
	move	r1, ${str}
	move	r2, ${suffix}
	int		iLAST_SUBSTRING_SEARCH
	cmp		r0, r3
	move	z, r0, TRUE, FALSE
#end_macro

